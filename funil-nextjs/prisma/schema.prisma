generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Lead {
  id        Int       @id @default(autoincrement())
  name      String
  channel   String
  group     String
  contact   String
  link      String
  createdAt DateTime  @default(now())
  feedback  Feedback?
}

model Feedback {
  id           Int      @id @default(autoincrement())
  leadId       Int      @unique
  lead         Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  status       String   @default("Pendente")
  replied      Boolean  @default(false)
  nps          Int?
  experience   String?
  satisfaction String?
  q1           String?
  q2           String?
  q3           String?
  q5           String?
  q6           String?
  q7           String?
  q8           String?
  q9           String?
  notes        String?
  updatedAt    DateTime @updatedAt
}
